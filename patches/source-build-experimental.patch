+void GLCanvas3D::set_center_of_gravity_marker(const Vec3d& pos, int obj_idx, int inst_idx)
+{
+    m_cog_marker.position = pos;
+    m_cog_marker.object_idx = obj_idx;
+    m_cog_marker.instance_idx = inst_idx;
+    m_cog_marker.visible = true;
+    m_dirty = true;
+}
+
+void GLCanvas3D::clear_center_of_gravity_marker()
+{
+    m_cog_marker.visible = false;
+    m_cog_marker.object_idx = -1;
+    m_cog_marker.instance_idx = -1;
+    m_dirty = true;
+}
+
+void GLCanvas3D::_render_center_of_gravity_marker()
+{
+    if (!m_cog_marker.visible)
+        return;
+
+    const Camera& camera = wxGetApp().plater()->get_camera();
+    const Vec3d& center = m_cog_marker.position;
+
+    if (!m_cog_marker.sphere.is_initialized()) {
+        m_cog_marker.sphere.reset();
+        indexed_triangle_set sphere_mesh = its_make_sphere(2.5, PI / 12.0);
+        m_cog_marker.sphere.init_from(std::move(sphere_mesh));
+    }
+
+    const float axis_len = 15.0f;
+    for (int i = 0; i < 3; ++i) {
+        if (!m_cog_marker.axes[i].is_initialized()) {
+            m_cog_marker.axes[i].reset();
+            GLModel::Geometry init_data;
+            init_data.format = { GLModel::Geometry::EPrimitiveType::Lines, GLModel::Geometry::EVertexLayout::P3 };
+            init_data.color = (i == X) ? ColorRGBA::X() : (i == Y) ? ColorRGBA::Y() : ColorRGBA::Z();
+            init_data.reserve_vertices(2);
+            init_data.reserve_indices(2);
+            if (i == X) {
+                init_data.add_vertex(Vec3f(-axis_len, 0.0f, 0.0f));
+                init_data.add_vertex(Vec3f(+axis_len, 0.0f, 0.0f));
+            } else if (i == Y) {
+                init_data.add_vertex(Vec3f(0.0f, -axis_len, 0.0f));
+                init_data.add_vertex(Vec3f(0.0f, +axis_len, 0.0f));
+            } else {
+                init_data.add_vertex(Vec3f(0.0f, 0.0f, -axis_len));
+                init_data.add_vertex(Vec3f(0.0f, 0.0f, +axis_len));
+            }
+            init_data.add_line(0, 1);
+            m_cog_marker.axes[i].init_from(std::move(init_data));
+        }
+    }
+
+    glsafe(::glDisable(GL_DEPTH_TEST));
+
+    GLShaderProgram* line_shader = wxGetApp().get_shader("flat");
+    if (line_shader != nullptr) {
+        line_shader->start_using();
+        line_shader->set_uniform("view_model_matrix", camera.get_view_matrix() * Geometry::translation_transform(center));
+        line_shader->set_uniform("projection_matrix", camera.get_projection_matrix());
+        for (int i = 0; i < 3; ++i) {
+            m_cog_marker.axes[i].render();
+        }
+        line_shader->stop_using();
+    }
+
+    GLShaderProgram* flat_shader = wxGetApp().get_shader("flat");
+    if (flat_shader != nullptr) {
+        flat_shader->start_using();
+        Transform3d view_model = camera.get_view_matrix() * Geometry::translation_transform(center);
+        flat_shader->set_uniform("view_model_matrix", view_model);
+        flat_shader->set_uniform("projection_matrix", camera.get_projection_matrix());
+        m_cog_marker.sphere.set_color(ColorRGBA(0.918f, 0.404f, 0.047f, 1.0f));
+        m_cog_marker.sphere.render();
+        flat_shader->stop_using();
+    }
+
+    glsafe(::glEnable(GL_DEPTH_TEST));
+}
