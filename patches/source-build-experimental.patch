+Vec3d CameraUtils::calculate_object_cog(const ModelObject &object, int instance_idx)
+{
+    if (instance_idx < 0 || instance_idx >= int(object.instances.size()))
+        instance_idx = 0;
+
+    const Transform3d inst_mat = (instance_idx < int(object.instances.size())) ? 
+        object.instances[instance_idx]->get_matrix() : Transform3d::Identity();
+
+    double total_volume = 0.0;
+    Vec3d cog_accum = Vec3d::Zero();
+    double total_area = 0.0;
+    Vec3d surface_centroid_accum = Vec3d::Zero();
+
+    for (const ModelVolume *volume : object.volumes) {
+        if (!volume || volume->type() != ModelVolumeType::MODEL_PART)
+            continue;
+
+        const indexed_triangle_set &its = volume->mesh().its;
+        if (its.empty())
+            continue;
+
+        const Transform3d total_trafo = inst_mat * volume->get_matrix();
+
+        for (const Vec3i &face : its.indices) {
+            const Vec3d p1 = total_trafo * its.vertices[face[0]].cast<double>();
+            const Vec3d p2 = total_trafo * its.vertices[face[1]].cast<double>();
+            const Vec3d p3 = total_trafo * its.vertices[face[2]].cast<double>();
+
+            // Signed volume of tetrahedron formed with origin (0,0,0)
+            const double v_tet = (p1.cross(p2)).dot(p3) / 6.0;
+            const Vec3d c_tet = 0.25 * (p1 + p2 + p3);
+
+            total_volume += v_tet;
+            cog_accum += v_tet * c_tet;
+
+            // Surface centroid fallback
+            const double area = 0.5 * ((p2 - p1).cross(p3 - p1)).norm();
+            total_area += area;
+            surface_centroid_accum += area * ((p1 + p2 + p3) / 3.0);
+        }
+    }
+
+    if (std::abs(total_volume) > 1e-4)
+        return cog_accum / total_volume;
+
+    if (total_area > 1e-4)
+        return surface_centroid_accum / total_area;
+
+    if (instance_idx < int(object.instances.size()))
+        return object.instances[instance_idx]->get_matrix() * object.raw_bounding_box().center();
+
+    return Vec3d::Zero();
+}
