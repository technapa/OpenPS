+void Plater::priv::set_camera_target_to_object_cog()
+{
+    const int obj_idx = get_selected_object_idx();
+    if (obj_idx < 0 || obj_idx >= int(model.objects.size()))
+        return;
+
+    const int inst_idx = std::max(0, get_selected_instance_idx());
+    const ModelObject* obj = model.objects[obj_idx];
+    if (!obj)
+        return;
+
+    const Vec3d cog = CameraUtils::calculate_object_cog(*obj, inst_idx);
+
+    get_camera().set_target(cog);
+
+    if (view3D && view3D->get_canvas3d()) {
+        view3D->get_canvas3d()->set_center_of_gravity_marker(cog, obj_idx, inst_idx);
+        view3D->get_canvas3d()->render();
+    }
+
+    if (notification_manager) {
+        notification_manager->push_notification(
+            NotificationType::CustomNotification,
+            NotificationManager::PreferencesNotificationLevel,
+            _u8L("Origine de la cam\xC3\xA9ra d\xC3\xA9finie au centre de l'objet actif."));
+    }
+}
+
+void Plater::priv::set_camera_target_to_bed_center()
+{
+    Vec3d bed_center = Vec3d::Zero();
+    if (view3D && view3D->get_canvas3d()) {
+        BoundingBoxf3 bed_bbox = bed.bounding_box_without_extensions();
+        const Vec2d bed_trans = multiple_beds.get_bed_translation(multiple_beds.get_active_bed());
+        if (bed_bbox.defined) {
+            bed_center = Vec3d(
+                0.5 * (bed_bbox.min.x() + bed_bbox.max.x()) + bed_trans.x(),
+                0.5 * (bed_bbox.min.y() + bed_bbox.max.y()) + bed_trans.y(),
+                0.0);
+        }
+        get_camera().set_target(bed_center);
+        view3D->get_canvas3d()->clear_center_of_gravity_marker();
+        view3D->get_canvas3d()->render();
+    } else {
+        get_camera().set_target(bed_center);
+    }
+
+    if (notification_manager) {
+        notification_manager->push_notification(
+            NotificationType::CustomNotification,
+            NotificationManager::PreferencesNotificationLevel,
+            _u8L("Origine de la cam\xC3\xA9ra d\xC3\xA9finie au centre du plateau."));
+    }
+}
